<%- include('partials/head', { title: 'Team settings', description: 'Skills, location, and teammate settings.' }) %>
<%- include('partials/header', { active: 'profile' }) %>
  <main id="main">
    <div class="container">
      <div class="page-title">
        <h1>Team settings</h1>
        <p>This is what the Team Finder uses to match you with other hackers.</p>
      </div>

      <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>

      <form class="form-card form-card-wide" method="post" action="/settings/team">
        <h2 class="form-heading">About you</h2>
        <label class="field">School
          <input type="text" name="school" value="<%= profile.school %>" maxlength="80">
        </label>
        <label class="field">Major
          <input type="text" name="major" value="<%= profile.major %>" maxlength="80">
        </label>
        <label class="field">City
          <input type="text" name="city" value="<%= profile.city %>" maxlength="80" placeholder="e.g. Birmingham, Alabama">
          <span class="hint">Only used to work out distances. Others see a rounded distance, never your exact spot.</span>
        </label>

        <h2 class="form-heading">Skills</h2>
        <%- include('partials/skill-picker', { skillList: allSkills, selected: profile.skills || [], custom: profile.custom_skills || '' }) %>

        <h2 class="form-heading">Hackathons you're interested in</h2>
        <%- include('partials/hack-picker', { selected: (profile.hackathons || []).map((h) => h.id) }) %>

        <h2 class="form-heading">Teammates</h2>
        <label class="choice">
          <input type="checkbox" name="looking_for_team" value="1"<%- profile.looking_for_team ? ' checked' : '' %>>
          <span>I'm looking for a team (show me in the Team Finder)</span>
        </label>
        <label class="field">Discord username
          <input type="text" name="discord" value="<%= profile.discord %>" maxlength="40" placeholder="username">
          <span class="hint">Only logged-in members can see it, and only while you're looking for a team.</span>
        </label>

        <div class="form-actions">
          <button class="btn" type="submit">Save</button>
          <a class="btn btn-dark" href="/profile">Cancel</a>
        </div>
      </form>
    </div>
  </main>

<%- include('partials/footer', { scripts: ['/js/forms.js'] }) %>
