<%- include('partials/header', { title: "Quests", description: "Practice hackathon skills with quests and earn pieces for your world.", active: "quests" }) %>
  <main id="main">
    <div class="container">
      <div class="page-title">
        <h1>Quests</h1>
        <p>Practice the skills you need at a hackathon. Finish a quest to earn something for your world.</p>
      </div>

      <% if (!user) { %>
        <p class="notice"><a href="/login">Log in</a> to play quests and earn world rewards.</p>
      <% } %>

      <link rel="stylesheet" href="/css/brainstorm.css">
      <h2 class="section-title">Pick a category</h2>
      <div class="bs-cards bs-columns">
        <article class="card bs-column">
          <span class="bs-icon" aria-hidden="true">💡⛏️</span>
          <h3>Project brainstorming</h3>
          <p>Find a project idea worth building, inspired by winning-style hackathon projects. Choose a mode:</p>
          <a class="bs-mode" href="/games/craft">
            <span class="bs-level">Easy</span>
            <strong>Village Crafting</strong>
            <span>Answer 3 questions and craft an item for a villager. Reward: nature.</span>
          </a>
          <a class="bs-mode survival" href="/games/survival">
            <span class="bs-level survival">Survival</span>
            <strong>Village Crafting: Night Shift</strong>
            <span>The same crafting game, but harder: tricky answers and no hints. Reward: a building.</span>
          </a>
        </article>
      </div>
    </div>
  </main>
<%- include('partials/footer') %>
