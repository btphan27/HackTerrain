<%- include('partials/header', { title: "Quests | HackOrGoHome", description: "Pick a game to build for your next hackathon.", active: "games" }) %>
  <main id="main">
    <div class="container">
      <div class="page-title">
        <h1>Quests</h1>
        <p>Pick a game to build for your next hackathon.</p>
      </div>

      <form class="filters" aria-label="Filter game ideas">
        <label>Genre
          <select name="genre"><option value="">All</option><option>Puzzle</option><option>Arcade</option><option>Strategy</option></select>
        </label>
        <label>Difficulty
          <select name="difficulty"><option value="">All</option><option>Beginner</option><option>Intermediate</option><option>Advanced</option></select>
        </label>
        <label>Time available
          <select name="time"><option value="">Any</option><option>24 hours</option><option>48 hours</option></select>
        </label>
        <button class="btn" type="submit">Apply filters</button>
      </form>

      <div class="grid">
        <% for (var i = 0; i < 6; i++) { %>
        <article class="card">
          <h3>Game idea title</h3>
          <p class="meta">Difficulty &bull; Time estimate</p>
          <p>One-line pitch for the game.</p>
          <span class="tag">Genre</span>
          <a class="btn btn-dark" href="#">View details</a>
        </article>
        <% } %>
      </div>
    </div>
  </main>
<%- include('partials/footer') %>
