<%
  const ev = editing;
  const init = ev ? { id: ev.id, name: ev.name, starts_on: ev.starts_on, ends_on: ev.ends_on, location: ev.location, format: ev.format, region: ev.region,
    description: ev.description, reg_url: ev.reg_url, theme: ev.theme, schedule: ev.schedule, quests: ev.quests } : null;
%>
<%- include('partials/header', { title: ev ? 'Edit your hackathon' : 'Launch Your Hackathon', description: 'Create a landing page for your hackathon and list it in the catalog.', active: 'host' }) %>

  <main id="main">
    <div class="container">
      <div class="page-title">
        <h1><%= ev ? 'Edit your hackathon' : 'Launch Your Hackathon' %></h1>
        <p>Pick a theme, fill in the details, and publish. Your event gets its own page and shows up in the hackathon catalog.</p>
      </div>

      <% if (!me) { %>
      <p class="notice"><a href="/login">Log in</a> to publish your hackathon. You can fill in the form first; your draft is kept in this browser.</p>
      <% } %>

      <% if (me && !ev && myEvents.length) { %>
      <section class="section" aria-labelledby="mine-heading">
        <h2 id="mine-heading" class="section-title">Your hackathons</h2>
        <div class="grid">
          <% myEvents.forEach((m) => { %>
          <article class="card">
            <h3><a href="/e/<%= m.slug %>"><%= m.name %></a></h3>
            <p class="meta"><%= m.dates %><% if (m.location) { %> &bull; <%= m.location %><% } %></p>
            <div class="host-actions">
              <a class="btn btn-dark" href="/e/<%= m.slug %>">View page</a>
              <a class="btn" href="/host/<%= m.id %>/edit">Edit</a>
              <% if (m.registrations !== null) { %><a class="btn btn-dark" href="/host/<%= m.id %>/registrations">Registrations (<%= m.registrations %>)</a><% } %>
              <button class="btn btn-dark" type="button" data-delete-id="<%= m.id %>" data-delete-name="<%= m.name %>">Delete</button>
            </div>
          </article>
          <% }) %>
        </div>
      </section>
      <h2 class="section-title"><%= 'Launch a new one' %></h2>
      <% } %>

      <div class="host-layout">
      <form id="host-form" aria-label="Hackathon landing page form" novalidate>
        <fieldset>
          <legend>Event details</legend>
          <p><label>Hackathon name<br><input type="text" name="event-name" maxlength="80" required></label></p>
          <div class="host-two">
            <p><label>Starts<br><input type="date" name="event-date" required></label></p>
            <p><label>Ends (optional)<br><input type="date" name="event-end"></label></p>
          </div>
          <div class="host-two">
            <p><label>Format<br>
              <select name="event-format"><% formats.forEach((f) => { %><option value="<%= f.id %>"><%= f.label %></option><% }) %></select></label></p>
            <p><label>Region<br>
              <select name="event-region"><% regions.forEach((r) => { %><option value="<%= r.id %>"><%= r.label %></option><% }) %></select></label></p>
          </div>
          <p><label>Location or link<br><input type="text" name="event-location" maxlength="120" placeholder="City, State, or a meeting link"></label></p>
          <p><label>Description<br><textarea name="event-description" rows="4" cols="40" maxlength="1500"></textarea></label></p>
        </fieldset>

        <fieldset>
          <legend>Theme</legend>
          <div class="theme-picker" role="radiogroup" aria-label="Page theme">
            <% themes.forEach((th, i) => { %>
            <label class="theme-opt theme-<%= th.id %>">
              <input type="radio" name="event-theme" value="<%= th.id %>"<%- i === 0 ? ' checked' : '' %>>
              <span class="theme-swatch" aria-hidden="true"></span>
              <span class="theme-name"><%= th.label %></span>
              <span class="theme-blurb"><%= th.blurb %></span>
            </label>
            <% }) %>
          </div>
        </fieldset>

        <fieldset>
          <legend>Schedule</legend>
          <div id="schedule-rows" class="host-rows">
            <div class="host-row">
              <label>Time<br><input type="time" name="schedule-time"></label>
              <label>Activity<br><input type="text" name="schedule-activity" maxlength="100"></label>
              <button class="btn btn-dark host-remove" type="button" aria-label="Remove this schedule item">Remove</button>
            </div>
          </div>
          <button class="btn" type="button" id="add-schedule">Add schedule item</button>
        </fieldset>

        <fieldset>
          <legend>Quests and prizes</legend>
          <div id="quest-rows" class="host-rows">
            <div class="host-row">
              <label>Quest or prize<br><input type="text" name="quest" maxlength="100"></label>
              <button class="btn btn-dark host-remove" type="button" aria-label="Remove this quest or prize">Remove</button>
            </div>
          </div>
          <button class="btn" type="button" id="add-quest">Add another</button>
        </fieldset>

        <fieldset>
          <legend>Registration</legend>
          <p><label>Registration link (optional)<br><input type="url" name="registration-url" placeholder="https://"></label></p>
          <p class="hint">No link? Leave this blank and we'll make a sign-up page for you on HackOrGoHome. You'll get a link to share and a list of everyone who registers.</p>
        </fieldset>

        <p id="host-msg" class="hint" role="status" aria-live="polite"></p>
        <p class="btn-row">
          <button class="btn" type="submit" id="host-submit"><%= ev ? 'Save changes' : 'Publish hackathon' %></button>
          <% if (ev) { %><a class="btn btn-dark" href="/e/<%= ev.slug %>">Cancel</a><% } %>
        </p>
      </form>

      <section class="host-preview-wrap" aria-labelledby="preview-heading">
        <h2 id="preview-heading" class="section-title">Preview</h2>
        <div id="host-preview" class="host-preview" aria-live="polite"></div>
      </section>
      </div>
    </div>
  </main>

<script type="application/json" id="host-init"><%- JSON.stringify(init).replace(/</g, '\\u003c') %></script>
<script type="application/json" id="host-config"><%- JSON.stringify({ loggedIn: !!me }) %></script>
<%- include('partials/footer', { scripts: ['/js/host.js'] }) %>
