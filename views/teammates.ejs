<%- include('partials/header', { title: 'Team Finder', description: 'Find teammates for an upcoming hackathon.', active: 'teammates' }) %>
  <main id="main">
    <div class="container">
      <div class="page-title">
        <h1>Team Finder</h1>
        <p>Find people who are looking for a team. Matches are ranked by shared hackathons, skills, school, and major.</p>
      </div>

      <%- include('partials/team-tabs', { tab: 'people' }) %>

      <% if (locals.me && locals.me.looking_for_team) { %>
      <p class="notice">You're listed as looking for a team. <a href="/settings/team">Edit your team settings</a></p>
      <% } else { %>
      <p class="notice">Other people can't find you yet. <a href="/settings/team">Turn on "looking for a team"</a> to show up here.</p>
      <% } %>

      <form class="filters" method="get" action="/teammates" aria-label="Filter teammates">
        <label>Skill
          <select name="skill">
            <option value="">Any</option>
            <% allSkills.forEach((s) => { %><option value="<%= s %>"<%- filters.skill === s ? ' selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
        </label>
        <% if (hasLocation) { %>
        <label>Distance
          <select name="radius">
            <option value="">Anywhere</option>
            <% [25, 50, 100, 250, 500].forEach((mi) => { %><option value="<%= mi %>"<%- Number(filters.radius) === mi ? ' selected' : '' %>>Within <%= mi %> miles</option>
            <% }) %>
          </select>
        </label>
        <% } %>
        <button class="btn" type="submit">Apply filters</button>
        <% if (filters.skill || filters.radius) { %><a class="btn btn-dark" href="/teammates">Clear</a><% } %>
      </form>

      <% if (!hasLocation) { %>
      <p class="hint">Want to filter by distance? <a href="/settings/team">Add your city</a> to turn it on.</p>
      <% } %>

      <% if (!matches.length) { %>
      <p class="empty">Nobody matches yet. Try clearing the filters, or check back as more people join.</p>
      <% } else { %>
      <p class="hint">Highlighted skills are ones you share.</p>
      <div class="grid">
        <% matches.forEach((m) => { const shownName = (m.display_name && !m.display_name.includes('@')) ? m.display_name : m.username; %>
        <article class="card mate">
          <div class="mate-top">
            <%- avatarHtml(m.avatar, m.picture, shownName, 'avatar-md') %>
            <div class="mate-who">
              <h3><a href="/u/<%= encodeURIComponent(m.username) %>"><%= shownName %></a></h3>
              <p class="mate-handle">@<%= m.username %></p>
              <% if (m.distance !== null) { %><span class="mate-chip">~<%= m.distance %> mi away</span><% } %>
            </div>
          </div>
          <div class="mate-body">
            <% if (m.school) { %><p class="mate-row"><span class="mate-ico" aria-hidden="true">&#127979;</span><span><%= m.school %><% if (m.major) { %> &middot; <%= m.major %><% } %></span></p><% } %>
            <% if (m.city) { %><p class="mate-row"><span class="mate-ico" aria-hidden="true">&#128205;</span><span><%= m.city %></span></p><% } %>
            <% if (m.experience) { %><p class="mate-row"><span class="mate-ico" aria-hidden="true">&#127942;</span><span><%= m.experience %></span></p><% } %>
            <% if (m.roles.length) { %><p class="mate-row"><span class="mate-ico" aria-hidden="true">&#128736;</span><span><%= m.roles.map((r) => r.split(' (')[0]).join(', ') %></span></p><% } %>
            <% if (m.sharedGoing.length) { %><p class="mate-row"><span class="mate-ico" aria-hidden="true">&#127919;</span><span>Also going to <%= m.sharedGoing.join(', ') %></span></p><% } %>
            <% if (m.sharedInterested.length) { %><p class="mate-row"><span class="mate-ico" aria-hidden="true">&#11088;</span><span>Also interested in <%= m.sharedInterested.join(', ') %></span></p><% } %>
            <% if (m.sameSchool) { %><p class="mate-badge">Same school as you</p><% } %>
            <% if (m.skills.length) { %>
            <div class="tag-row">
              <% m.skills.forEach((s) => { %><span class="tag<%- m.sharedSkills.includes(s) ? ' tag-honey' : '' %>"><%= s %></span><% }) %>
            </div>
            <% } %>
          </div>
          <div class="mate-foot">
            <% if (m.discord) { %><span class="mate-discord" title="Discord"><%- include('partials/discord-icon') %> <%= m.discord %></span><% } %>
            <a class="btn btn-dark" href="/u/<%= encodeURIComponent(m.username) %>">View profile</a>
            <a class="btn" href="/teams/invite/<%= encodeURIComponent(m.username) %>">Invite to team</a>
          </div>
        </article>
        <% }) %>
      </div>
      <% } %>
    </div>
  </main>

<%- include('partials/footer') %>
