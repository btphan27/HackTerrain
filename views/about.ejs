<%- include('partials/header', { title: 'About', description: 'About HackOrGoHome.', active: '' }) %>

  <main id="main">
    <div class="container">
      <div class="page-title">
        <h1>About HackOrGoHome</h1>
      </div>
      <section class="section">
        <p>Describe the project and who it's for.</p>
      </section>
      <section class="section">
        <h2>Contact</h2>
        <form aria-label="Contact form">
          <p><label>Name<br><input type="text" name="name"></label></p>
          <p><label>Email<br><input type="email" name="email"></label></p>
          <p><label>Message<br><textarea name="message" rows="5" cols="40"></textarea></label></p>
          <button class="btn" type="submit">Send message</button>
        </form>
      </section>
    </div>
  </main>

<%- include('partials/footer') %>
