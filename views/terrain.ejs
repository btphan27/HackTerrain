<%- include('partials/header', { title: (isOwner ? "My world" : "@" + owner + "'s world") + "", description: "Your world grows as you complete challenges.", active: "terrain" }) %>
  <main id="main">
    <div class="container">
      <div class="page-title">
        <h1><%= isOwner ? "Your world" : "@" + owner + "'s world" %></h1>
        <p><%= isOwner ? "Finish quests to earn plants, animals, and buildings, then drag them onto your land to build your own world." : "Look at what they've built." %></p>
      </div>
      <%- include('partials/terrain-widget', {
            api: isOwner ? '/api/terrain' : '/api/terrain/u/' + owner,
            editable: isOwner,
            dev: typeof terrainDev !== 'undefined' && terrainDev
      }) %>
      <p class="page-actions"><a class="btn btn-dark" href="/u/<%= owner %>">View profile</a></p>
    </div>
  </main>
<%- include('partials/footer') %>
