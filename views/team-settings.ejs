<%- include('partials/header', { title: "Skills and team info | HackOrGoHome", active: "profile" }) %>
  <main id="main">
    <div class="container">
      <div class="page-title"><h1>Skills and team info</h1></div>
      <form class="form-card" method="POST" action="/settings/team">
        <% if (error) { %><p class="error-msg" role="alert"><%= error %></p><% } %>
        <label class="field">School <input name="school" value="<%= profile.school %>"></label>
        <label class="field">Major <input name="major" value="<%= profile.major %>"></label>
        <label class="field">City <input name="city" placeholder="Atlanta, GA" value="<%= profile.city %>"></label>
        <label class="field">Discord username <input name="discord" placeholder="username" value="<%= profile.discord %>"></label>
        <label class="check"><input type="checkbox" name="looking_for_team" <%= profile.looking_for_team ? "checked" : "" %>>
          I'm looking for a team (shows my Discord to logged-in users)</label>

        <h3>Skills</h3>
        <div class="checks">
          <% allSkills.forEach(function (s) { %>
            <label><input type="checkbox" name="skills" value="<%= s %>" <%= profile.skills.includes(s) ? "checked" : "" %>> <%= s %></label>
          <% }) %>
        </div>
        <label class="field">Other skills, separated by commas
          <input name="custom_skills" placeholder="e.g. unity, solidity, blender" value="<%= profile.custom_skills %>"></label>

        <h3>Hackathons I'm interested in (up to 3)</h3>
        <%- include('partials/hackathon-picker', {
              hackathons: hackathons,
              selected: profile.hackathons.map(function (x) { return x.id; }),
              hasLocation: hasLocation, regions: regions, tags: tags
        }) %>

        <div class="btn-row">
          <button class="btn btn-primary" type="submit">Save</button>
          <a class="btn btn-dark" href="/profile">Back to profile</a>
        </div>
      </form>
    </div>
  </main>
<%- include('partials/footer') %>
