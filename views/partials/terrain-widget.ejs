<%# The terrain: a blank pixel landscape. Earned items wait in the inventory; drag them onto the land (or click an item, then click the land).
    Needs: api (where to load it from), editable (true/false), dev (show test buttons). %>
<div id="terrain-root" data-api="<%= api %>" data-editable="<%= editable ? 'true' : 'false' %>" data-dev="<%= dev ? 'true' : 'false' %>">
  <p id="tr-status">Loading your land...</p>
  <p id="tr-msg" aria-live="polite"></p>

  <div id="tr-scene" class="tr-scene" aria-label="Your terrain">
    <div id="tr-items" class="tr-items"></div>
    <p id="tr-empty" class="tr-empty" hidden></p>
  </div>
  <div id="tr-actions" class="tr-actions"></div>

  <section id="tr-bag" class="tr-bag"<%- editable ? '' : ' hidden' %>>
    <h2>Inventory</h2>
    <p class="hint" id="tr-bag-hint">Drag an item onto your land, or click it and then click where it should go. Drag an item back here to put it away.</p>
    <div id="tr-inv" class="tr-inv"></div>
  </section>

  <% if (dev && editable) { %>
    <fieldset id="tr-dev"><legend>Testing only: pretend a quest was completed</legend>
      <button class="btn btn-dark" type="button" data-dev="easy">Easy quest</button>
      <button class="btn btn-dark" type="button" data-dev="medium">Medium quest</button>
      <button class="btn btn-dark" type="button" data-dev="hard">Hard quest</button>
    </fieldset>
  <% } %>
</div>

<script src="/js/terrain-sprites.js"></script>
<script>
(function () {
  var root = document.getElementById("terrain-root");
  var api = root.dataset.api;
  var editable = root.dataset.editable === "true";
  var scene = document.getElementById("tr-scene");
  var itemsEl = document.getElementById("tr-items");
  var bag = document.getElementById("tr-bag");
  var UNITS = 64;      // the scene is 64 pixels wide; sprites are drawn in the same pixels
  var MIN_Y = 40;      // percent from the top: nothing is dropped up in the sky
  var state = null;
  var selected = null;

  function el(tag, cls, text) {
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  }
  function say(text) { document.getElementById("tr-msg").textContent = text || ""; }

  function call(method, url, body) {
    var opts = { method: method, credentials: "same-origin", headers: {} };
    if (body) { opts.headers["Content-Type"] = "application/json"; opts.body = JSON.stringify(body); }
    return fetch(url, opts).then(function (r) {
      return r.json().then(function (data) { if (!r.ok) throw new Error(data.error || "Something went wrong"); return data; });
    });
  }
  function act(action, body) {
    return call("POST", "/api/terrain/" + action, body)
      .then(function (res) { state = res.terrain; say(""); render(); })
      .catch(function (e) { say(e.message); render(); });
  }
  function find(id) {
    for (var i = 0; i < state.items.length; i++) if (state.items[i].id === id) return state.items[i];
    return null;
  }

  // The picture for an item: pixel sprite, or the emoji if there is no sprite yet
  function art(it, host) {
    var S = window.TerrainSprites;
    if (S && S.has(it.type)) { host.innerHTML = S.svg(it.type); return S.size(it.type); }
    host.textContent = it.emoji;
    return { w: 8, h: 8 };
  }

  function render() {
    var t = state, c = t.counts;
    var placed = t.placed.length, inBag = t.inventory.length;
    document.getElementById("tr-status").textContent =
      c.total + " item" + (c.total === 1 ? "" : "s") + " earned | " + c.nature + " nature, " + c.animal + " animals, " + c.building + " buildings" +
      (editable ? " | " + placed + " on your land, " + inBag + " in your inventory" : "");

    scene.className = "tr-scene" + (editable ? " is-editable" : "") + (selected !== null ? " has-selection" : "");

    // ----- items standing on the land (lower items are drawn in front) -----
    itemsEl.innerHTML = "";
    t.placed.slice().sort(function (a, b) { return a.y - b.y; }).forEach(function (it) {
      var b = el("button", "tr-item");
      b.type = "button";
      b.dataset.id = it.id; b.dataset.type = it.type; b.dataset.kind = it.kind;
      b.title = it.name + " (" + it.rarity + ")";
      b.setAttribute("aria-label", it.name + (editable ? ", on your land. Press to select it." : ""));
      var dim = art(it, b);
      b.style.left = it.x + "%"; b.style.top = it.y + "%";
      b.style.width = (dim.w / UNITS * 100) + "%";
      if (selected === it.id) b.classList.add("selected");
      itemsEl.appendChild(b);
    });

    var empty = document.getElementById("tr-empty");
    if (!placed) {
      empty.hidden = false;
      empty.textContent = editable
        ? (inBag ? "Your land is empty. Drag something from your inventory onto it!" : "Your land is empty. Finish quests to earn things to build with.")
        : "Nothing here yet.";
    } else { empty.hidden = true; }

    // ----- actions for the selected item -----
    var actions = document.getElementById("tr-actions");
    actions.innerHTML = "";
    var sel = selected !== null ? find(selected) : null;
    if (editable && sel) {
      var info = el("span", "tr-selected", "Selected: " + sel.name + (sel.x === null ? ". Click the land to place it." : ". Click the land to move it."));
      actions.appendChild(info);
      if (sel.x !== null) {
        var back = el("button", "btn btn-dark", "Put back in inventory");
        back.type = "button";
        back.addEventListener("click", function () { var id = selected; selected = null; act("remove", { id: id }); });
        actions.appendChild(back);
      }
    }

    // ----- the bag -----
    var inv = document.getElementById("tr-inv");
    inv.innerHTML = "";
    if (!inBag) {
      inv.appendChild(el("p", "tr-bag-empty", editable && c.total === 0
        ? "Nothing yet. Finish a quest to earn your first item."
        : "Your inventory is empty."));
    }
    t.inventory.forEach(function (it) {
      var b = el("button", "tr-bag-item");
      b.type = "button";
      b.dataset.id = it.id; b.dataset.type = it.type; b.dataset.kind = it.kind;
      b.title = it.name + " (" + it.rarity + ")";
      b.setAttribute("aria-label", it.name + " in your bag. Press to select it.");
      var holder = el("span", "tr-bag-art");
      art(it, holder);
      b.appendChild(holder);
      b.appendChild(el("span", "tr-bag-name", it.name));
      if (selected === it.id) b.classList.add("selected");
      inv.appendChild(b);
    });
  }

  // ---------- Drag and drop (mouse, touch and pen all work) ----------
  var drag = null;

  function sceneRect() { return scene.getBoundingClientRect(); }
  function inside(r, x, y) { return x >= r.left && x <= r.right && y >= r.top && y <= r.bottom; }

  function toPercent(x, y) {
    var r = sceneRect();
    var px = (x - r.left) / r.width * 100;
    var py = (y - r.top) / r.height * 100;
    return { x: Math.max(2, Math.min(98, px)), y: Math.max(MIN_Y, Math.min(99, py)) };
  }

  function startDrag(e, source) {
    if (!editable || e.button > 0) return;
    var node = e.target.closest("[data-id]");
    if (!node) return;
    var it = find(Number(node.dataset.id));
    if (!it) return;
    drag = { id: it.id, item: it, from: source, node: node, sx: e.clientX, sy: e.clientY, moving: false, ghost: null, pid: e.pointerId };
  }

  function makeGhost() {
    var it = drag.item;
    var g = el("div", "tr-ghost");
    var dim = art(it, g);
    g.style.width = (dim.w / UNITS * sceneRect().width) + "px";
    document.body.appendChild(g);
    drag.ghost = g;
    drag.node.classList.add("is-lifted");
  }

  function moveGhost(x, y) {
    if (!drag.ghost) return;
    drag.ghost.style.left = x + "px";
    drag.ghost.style.top = y + "px";
    scene.classList.toggle("is-target", inside(sceneRect(), x, y));
    bag.classList.toggle("is-target", drag.from === "scene" && inside(bag.getBoundingClientRect(), x, y));
  }

  function endDrag(e, cancelled) {
    var d = drag; drag = null;
    if (!d) return;
    scene.classList.remove("is-target"); bag.classList.remove("is-target");
    if (d.ghost) d.ghost.remove();
    if (d.node) d.node.classList.remove("is-lifted");
    if (!d.moving) {                       // it was a click: select / unselect
      selected = selected === d.id ? null : d.id;
      render();
      return;
    }
    if (cancelled) { render(); return; }
    if (inside(sceneRect(), e.clientX, e.clientY)) {
      var p = toPercent(e.clientX, e.clientY);
      selected = null;
      act("place", { id: d.id, x: p.x, y: p.y });
    } else if (d.from === "scene" && inside(bag.getBoundingClientRect(), e.clientX, e.clientY)) {
      selected = null;
      act("remove", { id: d.id });
    } else {
      render();
    }
  }

  document.addEventListener("pointermove", function (e) {
    if (!drag || e.pointerId !== drag.pid) return;
    if (!drag.moving) {
      if (Math.abs(e.clientX - drag.sx) + Math.abs(e.clientY - drag.sy) < 6) return;
      drag.moving = true;
      makeGhost();
    }
    e.preventDefault();
    moveGhost(e.clientX, e.clientY);
  }, { passive: false });
  document.addEventListener("pointerup", function (e) { if (drag && e.pointerId === drag.pid) endDrag(e, false); });
  document.addEventListener("pointercancel", function (e) { if (drag && e.pointerId === drag.pid) endDrag(e, true); });

  if (editable) {
    itemsEl.addEventListener("pointerdown", function (e) { startDrag(e, "scene"); });
    document.getElementById("tr-inv").addEventListener("pointerdown", function (e) { startDrag(e, "bag"); });
    // Keyboard: Enter/Space on an item is a click; the pointer handlers above do not fire for it
    root.addEventListener("keydown", function (e) {
      if ((e.key === "Enter" || e.key === " ") && e.target.dataset && e.target.dataset.id && !drag) {
        e.preventDefault();
        var id = Number(e.target.dataset.id);
        selected = selected === id ? null : id;
        render();
        var again = root.querySelector('[data-id="' + id + '"]');
        if (again) again.focus();
      }
    });
    // Click-to-place: select something, then click the land
    scene.addEventListener("click", function (e) {
      if (selected === null || e.target.closest(".tr-item")) return;
      var p = toPercent(e.clientX, e.clientY);
      var id = selected; selected = null;
      act("place", { id: id, x: p.x, y: p.y });
    });
  }

  function load() {
    return call("GET", api).then(function (data) { state = data; render(); })
      .catch(function (e) { document.getElementById("tr-status").textContent = "Couldn't load the terrain: " + e.message; });
  }

  var dev = document.getElementById("tr-dev");
  if (dev) {
    dev.addEventListener("click", function (e) {
      var d = e.target.dataset && e.target.dataset.dev;
      if (!d) return;
      call("POST", "/api/terrain/dev-grant", { difficulty: d }).then(function (res) {
        state = res.terrain;
        say("You earned: " + res.reward.name + " (" + res.reward.rarity + "). It is in your bag.");
        render();
      }).catch(function (err) { say(err.message); });
    });
  }

  window.addEventListener("resize", function () { if (drag && drag.ghost) { drag.ghost.style.width = (TerrainSprites.size(drag.item.type).w / UNITS * sceneRect().width) + "px"; } });
  load();
})();
</script>
