<%
  var _title = typeof title !== "undefined" && title ? title + " | HackOrGoHome" : "HackOrGoHome";
  var _desc = typeof description !== "undefined" ? description : "Find everything you need for a hackathon here! Look up hackathons, build your skills through games, and find a team!";
  var _body = typeof bodyClass !== "undefined" ? bodyClass : "";
  var _active = typeof active !== "undefined" ? active : "";
  var cur = function (name) { return _active === name ? ' aria-current="page"' : ""; };
  var _loggedIn = typeof user !== "undefined" && user;
-%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= _title %></title>
  <meta name="description" content="<%= _desc %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800&family=Pixelify+Sans:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body<%- _body ? ' class="' + _body + '"' : '' %>>
  <a class="skip-link" href="#main">Skip to content</a>

  <!-- HEADER: logo left, tabs right -->
  <header class="site-header">
    <div class="container">
      <a class="logo" href="/" aria-label="HackOrGoHome home">HackOrGoHome<span class="logo-bee" aria-hidden="true"><svg class="logo-bee-svg" viewBox="0 0 14 8" shape-rendering="crispEdges" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><rect x="13" y="2" width="1" height="1" fill="#4b3a68"/><rect x="3" y="3" width="8" height="1" fill="#4b3a68"/><rect x="12" y="3" width="1" height="1" fill="#4b3a68"/><rect x="2" y="4" width="1" height="1" fill="#4b3a68"/><rect x="3" y="4" width="2" height="1" fill="#ffdf6b"/><rect x="5" y="4" width="1" height="1" fill="#4b3a68"/><rect x="6" y="4" width="2" height="1" fill="#ffdf6b"/><rect x="8" y="4" width="1" height="1" fill="#4b3a68"/><rect x="9" y="4" width="1" height="1" fill="#ffdf6b"/><rect x="10" y="4" width="1" height="1" fill="#4b3a68"/><rect x="11" y="4" width="1" height="1" fill="#4b3a68"/><rect x="1" y="5" width="2" height="1" fill="#4b3a68"/><rect x="3" y="5" width="2" height="1" fill="#ffdf6b"/><rect x="5" y="5" width="1" height="1" fill="#4b3a68"/><rect x="6" y="5" width="2" height="1" fill="#ffdf6b"/><rect x="8" y="5" width="1" height="1" fill="#4b3a68"/><rect x="9" y="5" width="1" height="1" fill="#ffb3c9"/><rect x="10" y="5" width="1" height="1" fill="#ffdf6b"/><rect x="11" y="5" width="1" height="1" fill="#4b3a68"/><rect x="3" y="6" width="8" height="1" fill="#4b3a68"/><rect x="4" y="7" width="1" height="1" fill="#4b3a68"/><rect x="9" y="7" width="1" height="1" fill="#4b3a68"/><g class="wing"><rect x="5" y="0" width="4" height="1" fill="#bfe0f5"/><rect x="4" y="1" width="1" height="1" fill="#bfe0f5"/><rect x="5" y="1" width="4" height="1" fill="#eaf7ff"/><rect x="9" y="1" width="1" height="1" fill="#bfe0f5"/><rect x="4" y="2" width="1" height="1" fill="#bfe0f5"/><rect x="5" y="2" width="4" height="1" fill="#eaf7ff"/><rect x="9" y="2" width="1" height="1" fill="#bfe0f5"/></g></svg></span></a>
      <nav aria-label="Main">
        <ul class="nav-list">
          <li><a href="/games"<%- cur("quests") %>>Quests</a></li>
          <li><a href="/hackathons"<%- cur("hackathons") %>>Hackathons</a></li>
          <li><a href="/teammates"<%- cur("teammates") %>>Team Finder<% if (locals.teamBadge) { %> <span class="nav-badge" aria-label="<%= teamBadge %> waiting for you"><%= teamBadge %></span><% } %></a></li>
          <li><a href="/terrain"<%- cur("terrain") %>>My World</a></li>
          <li><a href="/host"<%- cur("host") %>>Launch Your Hackathon</a></li>
          <% if (_loggedIn) { %>
            <li><a href="/profile"<%- cur("profile") %>>My Profile</a></li>
            <li><a href="/logout">Log out</a></li>
          <% } else { %>
            <li><a class="nav-cta" href="/login">Log in</a></li>
          <% } %>
        </ul>
      </nav>
    </div>
  </header>
