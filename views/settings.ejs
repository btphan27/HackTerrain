<%- include('partials/header', { title: "Account settings | HackOrGoHome", active: "profile" }) %>
  <main id="main">
    <div class="container">
      <div class="page-title"><h1>Account settings</h1></div>
      <form class="form-card" method="POST" action="/settings">
        <% if (error) { %><p class="error-msg" role="alert"><%= error %></p><% } %>
        <label class="field">Username <input name="username" value="<%= profile.username %>" required></label>
        <label class="field">Name <input name="display_name" value="<%= profile.display_name %>"></label>
        <label class="field">Short bio <textarea name="bio" maxlength="200" rows="3"><%= profile.bio %></textarea></label>
        <div class="btn-row">
          <button class="btn btn-primary" type="submit">Save</button>
          <a class="btn btn-dark" href="/settings/team">Skills and team info</a>
          <a class="btn btn-dark" href="/profile">Back to profile</a>
        </div>
      </form>
    </div>
  </main>
<%- include('partials/footer') %>
