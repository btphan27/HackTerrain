<%- include('partials/header', { title: 'Settings', description: 'Account settings.', active: 'profile' }) %>
  <main id="main">
    <div class="container">
      <div class="page-title">
        <h1>Settings</h1>
        <p>Your public name and bio. Skills, location, and teammate settings are under <a href="/settings/team">Team settings</a>.</p>
      </div>

      <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>

      <form class="form-card" method="post" action="/settings">
        <label class="field">Username
          <input type="text" name="username" value="<%= profile.username %>" required minlength="3" maxlength="20" autocomplete="username">
          <span class="hint">3-20 characters: letters, numbers, or underscores. Your page is /u/username.</span>
        </label>
        <label class="field">Display name
          <input type="text" name="display_name" value="<%= profile.display_name %>" maxlength="50">
        </label>
        <label class="field">Bio
          <textarea name="bio" rows="4" maxlength="200"><%= profile.bio %></textarea>
          <span class="hint">Up to 200 characters.</span>
        </label>
        <div class="form-actions">
          <button class="btn" type="submit">Save changes</button>
          <a class="btn btn-dark" href="/profile">Cancel</a>
        </div>
      </form>
    </div>
  </main>

<%- include('partials/footer') %>
