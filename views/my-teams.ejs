<%- include('partials/header', { title: 'My teams', description: 'Your teams, invites and requests.', active: 'teammates' }) %>
  <main id="main">
    <div class="container">
      <div class="page-title">
        <h1>My teams</h1>
        <p>Your teams, plus anything waiting for your answer.</p>
      </div>
      <%- include('partials/team-tabs', { tab: 'mine' }) %>
      <%- include('partials/flash', { flash: flash }) %>

      <% if (inbox.invites.length) { %>
      <section class="section" aria-labelledby="inv-h">
        <h2 id="inv-h" class="section-title">Invites for you</h2>
        <div class="grid">
          <% inbox.invites.forEach((i) => { %>
          <article class="card">
            <h3><a href="/teams/<%= i.team_id %>"><%= i.team_name %></a></h3>
            <p class="meta">@<%= i.from_username %> invited you</p>
            <div class="host-actions">
              <form method="post" action="/teams/requests/<%= i.id %>/accept"><button class="btn" type="submit">Accept</button></form>
              <form method="post" action="/teams/requests/<%= i.id %>/decline"><button class="btn btn-dark" type="submit">Decline</button></form>
            </div>
          </article>
          <% }) %>
        </div>
      </section>
      <% } %>

      <% if (inbox.requests.length) { %>
      <section class="section" aria-labelledby="req-h">
        <h2 id="req-h" class="section-title">People who want to join</h2>
        <div class="grid">
          <% inbox.requests.forEach((r) => { %>
          <article class="card">
            <div class="card-head"><%- avatarHtml(r.avatar, r.picture, r.display_name || r.username, 'avatar-sm') %><h3><a href="/u/<%= encodeURIComponent(r.username) %>">@<%= r.username %></a></h3></div>
            <p class="meta">Wants to join <a href="/teams/<%= r.team_id %>"><%= r.team_name %></a></p>
            <% if (r.message) { %><p class="team-desc">&ldquo;<%= r.message %>&rdquo;</p><% } %>
            <div class="host-actions">
              <form method="post" action="/teams/requests/<%= r.id %>/accept"><button class="btn" type="submit">Accept</button></form>
              <form method="post" action="/teams/requests/<%= r.id %>/decline"><button class="btn btn-dark" type="submit">Decline</button></form>
            </div>
          </article>
          <% }) %>
        </div>
      </section>
      <% } %>

      <section class="section" aria-labelledby="mine-h">
        <h2 id="mine-h" class="section-title">Your teams</h2>
        <% if (!teams.length) { %>
          <p class="empty">You're not on a team yet. <a href="/teams">Browse teams</a>, <a href="/teammates">find people</a>, or <a href="/teams/new">create a team</a>.</p>
        <% } else { %>
        <div class="grid"><% teams.forEach((team) => { %><%- include('partials/team-card', { team: team }) %><% }) %></div>
        <% } %>
      </section>

      <% if (inbox.sent.length) { %>
      <section class="section" aria-labelledby="sent-h">
        <h2 id="sent-h" class="section-title">Requests you sent</h2>
        <ul class="plain-list">
          <% inbox.sent.forEach((s) => { %>
          <li class="sent-row"><a href="/teams/<%= s.team_id %>"><%= s.team_name %></a> <span class="meta">waiting for an answer</span>
            <form method="post" action="/teams/requests/<%= s.id %>/cancel"><button class="btn btn-dark" type="submit">Withdraw</button></form></li>
          <% }) %>
        </ul>
      </section>
      <% } %>
    </div>
  </main>
<%- include('partials/footer') %>
